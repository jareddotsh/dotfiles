sketchybar --add item net.speed right \
           --set net.speed script="$PLUGIN_DIR/network.sh" \
          update_freq=1 \
          icon=󰛳 \
          label.font="FiraCode Nerd Font:Semibold:12.0" \


# Force all scripts to run the first time (never do this in a script)
sketchybar --update

